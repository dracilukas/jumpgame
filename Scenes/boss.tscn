[sub_resource type="GDScript" id="GDScript_poog2"]
resource_name = "boss"
script/source = "extends RigidBody2D

@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D
@onready var collision_shape_2d: CollisionShape2D = $CollisionShape2D
@onready var utok: AnimatedSprite2D = $utok
@onready var utok_2: AnimatedSprite2D = $utok2




var muzeutocit = true

func zmenitanimaci():
	print(global_position)
	if utok_2.visible == true:
		return
	if muzeutocit == false:
		return
	$idle.visible = false
	$idle.stop()
	$utok.visible = true
	$utok.play()
	await get_tree().create_timer(1.2).timeout
	GameManager.decrease_health()
	$utok.visible = false
	$utok.stop()
	$idle.visible = true
	$idle.play()
	muzeutocit = false
	await get_tree().create_timer(2).timeout
	muzeutocit = true
	
	
func zmenitanimacih():
	if utok.visible == true:
		return
	if muzeutocit == false:
		return
	$idle.visible = false
	$idle.stop()
	$utok2.visible = true
	$utok2.play()
	await get_tree().create_timer(1.2).timeout
	GameManager.decrease_health()
	$utok2.visible = false
	$utok2.stop()
	$idle.visible = true
	$idle.play()
	muzeutocit = false
	await get_tree().create_timer(2).timeout
	muzeutocit = true
"

